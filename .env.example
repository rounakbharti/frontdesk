# ============================================================
# Frontdesk AI — Environment Configuration
# Copy this to .env and adjust values for your local setup.
# NEVER commit .env to version control.
# ============================================================

# ----- NLU / Agent -----
# "mock" (default, deterministic) | "local_model" (requires capable host)
NLU_MODE=mock
AGENT_CONFIDENCE_THRESHOLD=0.7
MAX_NLU_CONCURRENCY=4

# ----- Help Request Lifecycle -----
HELP_REQ_TIMEOUT_SECS=600

# ----- Notification Simulator -----
# "console" | "webhook"
NOTIFICATION_MODE=console
NOTIFICATION_WEBHOOK_URL=http://localhost:4005/notify

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=frontdesk
POSTGRES_USER=frontdesk
POSTGRES_PASSWORD=frontdesk_secret
POSTGRES_URL=postgres://frontdesk:frontdesk_secret@localhost:5432/frontdesk

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ----- Apache Kafka -----
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=frontdesk-ai
# Comma-separated list of topics to auto-create on boot
KAFKA_TOPICS=help_request.created,help_request.resolved,help_request.timed_out,supervisor.answered,kb.learn

# ----- Elasticsearch -----
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_KB=frontdesk_kb
ELASTICSEARCH_INDEX_AUDIT=frontdesk_audit

# ----- Service Ports -----
PORT_AGENT=4001
PORT_HELP_REQUEST=4002
PORT_NLU_ADAPTER=4003
PORT_NOTIFICATION=4004
PORT_KB=4005

# ----- Observability -----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=frontdesk-ai
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090

# ----- Security / JWT (placeholder — not used in Phase 1) -----
JWT_SECRET=change_me_in_production
