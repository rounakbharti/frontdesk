{
  "name": "frontdesk-ai",
  "version": "1.0.0",
  "description": "Human-in-the-Loop AI Supervisor — Frontdesk Engineering Assessment",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:up": "bash dev.sh up",
    "dev:down": "bash dev.sh down",
    "dev:logs": "bash dev.sh logs",
    "dev:reset": "bash dev.sh reset",
    "lint": "eslint \"./{services,workers,packages}/*/src/**/*.ts\" --ext .ts",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "workspaces": [
    "services/*",
    "web/*",
    "workers/*"
  ],
  "devDependencies": {
    "@hapi/catbox": "^12.1.1",
    "@hapi/iron": "^7.0.1",
    "@hapi/shot": "^6.0.1",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
